  <PrjInfo>
    <NamePrj>2026-117</NamePrj>
    <LblPrj>Kita Sonnenblume, Außenanlagen</LblPrj>
    <Cur>EUR</Cur>
  </PrjInfo>
  <Award>
    <DP>83</DP>
    <BoQ ID="BOQ1">
      <BoQInfo>
        <Name>LV 01</Name>
        <LblTx><p><span>Außenanlagen &amp; Pflaster</span></p></LblTx>
        <BoQBkdn><Type>BoQLevel</Type><Length>2</Length><Num>Yes</Num></BoQBkdn>
        <BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn>
      </BoQInfo>
      <BoQBody>
        <BoQCtgy RNoPart="01">
          <LblTx><p><span>Erdarbeiten</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010">
                <Qty>125.500</Qty>
                <QU>m2</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt><Text><p><span>Oberboden abtragen, 20 cm, seitlich lagern.</span></p></Text></DetailTxt>
                    <OutlineText><OutlTxt><TextOutlTxt><p><span>Oberboden abtragen</span></p></TextOutlTxt></OutlTxt></OutlineText>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0020">
                <Qty>42</Qty>
                <QU>m3</QU>
                <Description>
                  <CompleteText>
                    <DetailTxt><Text><p><span>Boden lösen und laden, Bodenklasse 3–5,</span></p><p><span>abfahren &amp; entsorgen.</span></p></Text></DetailTxt>
                  </CompleteText>
                </Description>
              </Item>
              <Item RNoPart="0030">
                <Qty>10</Qty>
                <QU>m3</QU>
                <Provis>WithoutTotal</Provis>
                <Description><CompleteText><OutlineText><OutlTxt><TextOutlTxt><p><span>Bodenaustausch (Bedarf)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
        <BoQCtgy RNoPart="02">
          <LblTx><p><span>Pflasterarbeiten</span></p></LblTx>
          <BoQBody>
            <Itemlist>
              <Item RNoPart="0010">
                <Qty>80.000</Qty>
                <QU>m2</QU>
                <Description><CompleteText><OutlineText><OutlTxt><TextOutlTxt><p><span>Betonpflaster verlegen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description>
              </Item>
              <Item RNoPart="0020">
                <QU>psch</QU>
                <Description><CompleteText><OutlineText><OutlTxt><TextOutlTxt><p><span>Baustelleneinrichtung</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description>
              </Item>
              <Item RNoPart="0030">
                <Qty>80</Qty>
                <QU>m2</QU>
                <ALNGroupNo>1</ALNGroupNo>
                <ALNSerNo>1</ALNSerNo>
                <Description><CompleteText><OutlineText><OutlTxt><TextOutlTxt><p><span>Natursteinpflaster (Wahl)</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description>
              </Item>
            </Itemlist>
          </BoQBody>
        </BoQCtgy>
      </BoQBody>
    </BoQ>
  </Award>

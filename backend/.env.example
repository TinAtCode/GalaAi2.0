DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gartenai?schema=public"
JWT_SECRET="bitte-durch-einen-langen-zufaelligen-wert-ersetzen"
PORT=3000
# Optional: auf eine bestimmte Domain einschränken (Produktion). Leer = offen (nur für lokale Entwicklung).
CORS_ORIGIN=
# Verzeichnis für hochgeladene Dokumente (lokaler Objektspeicher, Punkt 6). Standard: ./uploads
UPLOADS_DIR=
# Login-Versuche pro Minute und IP (Brute-Force-Schutz). Standard: 5. Nur für E2E-Tests erhöhen.
LOGIN_RATE_LIMIT=

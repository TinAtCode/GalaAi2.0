DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gartenai?schema=public"
JWT_SECRET="bitte-durch-einen-langen-zufaelligen-wert-ersetzen"
PORT=3000
# Adresse(n) des Frontends, kommagetrennt (Produktion z.B. https://app.gartenai.de).
# Leer = nur das lokale Vite-Frontend (http://localhost:5173).
CORS_ORIGIN=
# Sitzungs-Cookie: Secure ist in Produktion (NODE_ENV=production) automatisch an.
# COOKIE_SECURE=1|0 überschreibt das; COOKIE_SAMESITE=lax (Standard), strict oder none
# (none nur, wenn Frontend und API auf verschiedenen Domains liegen – dann immer mit HTTPS).
COOKIE_SECURE=
COOKIE_SAMESITE=
# Verzeichnis für hochgeladene Dokumente (lokaler Objektspeicher, Punkt 6). Standard: ./uploads
UPLOADS_DIR=
# Dokumente im S3-kompatiblen Objektspeicher statt im Dateisystem: STORAGE=s3
# (AWS, Hetzner, IONOS, Wasabi, MinIO …). Bucket vorher anlegen. S3_ENDPOINT leer = AWS.
# S3_FORCE_PATH_STYLE: Standard an, sobald S3_ENDPOINT gesetzt ist. S3_SSE=AES256 für
# serverseitige Verschlüsselung. Umzug vorhandener Dateien: node dist/cli/migrate-storage.js
STORAGE=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=
S3_SSE=
# Login-Versuche pro Minute je Konto und IP (Brute-Force-Schutz). Standard: 5. Nur für Tests erhöhen.
LOGIN_RATE_LIMIT=
# Login-Versuche pro Minute je IP über alle Konten. Standard: 30. Nur für Tests erhöhen.
LOGIN_IP_RATE_LIMIT=
# E-Mail-Versand (Rechnungen). Ohne SMTP_URL ist der Versand abgeschaltet.
# Beispiel: SMTP_URL=smtps://nutzer:passwort@mail.example.de:465
SMTP_URL=
# Absender, z.B. MAIL_FROM="Musterbetrieb <rechnung@musterbetrieb.de>". Antworten gehen an die E-Mail der Firma.
MAIL_FROM=
# Anfragen pro Minute je angemeldetem Nutzer bzw. je IP (anonym). Standard: 300. Nur für Tests erhöhen.
RATE_LIMIT=
# Anzahl vertrauenswürdiger Reverse-Proxys vor dem Backend (z.B. 1 hinter nginx). Ohne Proxy leer lassen.
TRUST_PROXY=
# Log-Format: json für den Betrieb (eine JSON-Zeile pro Ereignis), leer = lesbare Ausgabe
LOG_FORMAT=
# Wie viele Texterkennungen (OCR) gleichzeitig laufen dürfen. Standard: 2
OCR_CONCURRENCY=
# Token für Prometheus (GET /metrics mit Authorization: Bearer <Token>). Leer = /metrics abgeschaltet
METRICS_TOKEN=
# Verlauf der Betriebswerte für die Alarmschwellen (ein Messpunkt je Minute in der Datenbank).
# Standard: an (außer in Tests); off = abgeschaltet. Aufbewahrung in Tagen, Standard 90
METRICS_HISTORY=
METRICS_HISTORY_DAYS=

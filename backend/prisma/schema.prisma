generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Mandant / Unternehmen
// ─────────────────────────────────────────────
model Company {
  id                String    @id @default(uuid())
  name              String
  // Startkategorien und -regeln der Finanzen angelegt (einmalig)
  financeDefaultsAt DateTime?

  // Pflichtangaben für Rechnungen (§ 14 UStG): Anschrift und Steuernummer
  // oder USt-IdNr. Ohne sie lässt sich keine Rechnung ausstellen.
  street     String?
  postalCode String?
  city       String?
  taxNumber  String? // Steuernummer vom Finanzamt
  vatId      String? // USt-IdNr., z.B. DE123456789
  createdAt  DateTime @default(now())

  // Zusätzlich für die E-Rechnung (XRechnung): Kontakt und Bankverbindung
  email           String?
  phone           String?
  contactName     String? // Ansprechpartner; ohne Angabe der Firmenname
  iban            String?
  bic             String?
  paymentTermDays Int     @default(14) // Zahlungsziel in Tagen
  // Kleinunternehmer nach § 19 UStG: Angebote und Rechnungen ohne Umsatzsteuer
  smallBusiness   Boolean @default(false)

  // Konfigurierbare Kalkulationsgrundlagen (Punkt 20: keine starre,
  // fest eingebaute Marge). Werden vom Calculations-Modul genutzt und
  // können pro Anfrage überschrieben werden (siehe CalculateServiceDto).
  hourlyLaborRate          Decimal @default(45.00) @db.Decimal(10, 2)
  overheadPercent          Decimal @default(15.00) @db.Decimal(5, 2)
  defaultSurchargePercent  Decimal @default(20.00) @db.Decimal(5, 2)
  // Grundlage für die Überstundenberechnung (Punkt 29: "später
  // Arbeitszeitmodelle, Zuschläge"). Bewusst einfach gehalten: eine
  // Regelarbeitszeit pro Tag statt komplexer Schichtmodelle – siehe STATUS.md.
  regularDailyHours        Decimal @default(8.00) @db.Decimal(4, 2)
  overtimeSurchargePercent Decimal @default(25.00) @db.Decimal(5, 2)

  // IANA-Zeitzone für Tagesgrenzen (Mein Tag, Überstunden, Terminkollision)
  timeZone String @default("Europe/Berlin")

  // Standard-Umsatzsteuersatz für neue Angebote (Prozent)
  defaultVatRate Decimal @default(19.00) @db.Decimal(5, 2)

  // DATEV-Export (Buchungsstapel für den Steuerberater)
  datevConsultantNumber Int? // Beraternummer
  datevClientNumber     Int? // Mandantennummer
  datevChartOfAccounts  DatevChart @default(SKR03)
  // Abweichende Erlöskonten: {"standard19": 8400, "standard7": 8300,
  // "smallBusiness": 8195, "reverseCharge": 8337}; fehlende Einträge = Standard
  datevRevenueAccounts  Json?

  // Mahnwesen: neue Zahlungsfrist in Tagen ab dem Mahndatum
  dunningDeadlineDays Int      @default(7)
  // Mahngebühren je Stufe (Zahlungserinnerung, 1., 2. Mahnung), 0 = keine
  dunningFee1         Decimal  @default(0) @db.Decimal(8, 2)
  dunningFee2         Decimal  @default(0) @db.Decimal(8, 2)
  dunningFee3         Decimal  @default(0) @db.Decimal(8, 2)
  // Verzugszinsen nach § 288 BGB (aus bis eingeschaltet); Basiszinssatz der
  // Bundesbank, ändert sich zum 1.1. und 1.7.
  dunningInterest     Boolean  @default(false)
  baseInterestRate    Decimal? @db.Decimal(5, 2)
  // Pauschale 40 € bei Geschäftskunden (§ 288 Abs. 5 BGB)
  dunningLumpSum      Boolean  @default(false)

  // Rundung der Mengen auf Angeboten und Rechnungen (Standard; Einheit,
  // Leistung/Artikel und Position können abweichen, siehe common/units.ts)
  quantityDecimals Int              @default(2)
  quantityRounding QuantityRounding @default(half_up)

  users     User[]
  roles     Role[]
  customers Customer[]
  articles  Article[]
  services  Service[]
  suppliers Supplier[]
  machines  Machine[]
  employees Employee[]
  documents Document[]
  auditLogs AuditLog[]

  // direkte Mandanten-Zuordnung (statt Join-Kette Projekt -> Objekt -> Kunde)
  properties           Property[]
  projects             Project[]
  quotes               Quote[]
  orders               Order[]
  appointments         Appointment[]
  timeEntries          TimeEntry[]
  materialUsages       ProjectMaterialUsage[]
  numberSequences      NumberSequence[]
  invoices             Invoice[]
  ocrJobs              OcrJob[]
  invoicePayments      InvoicePayment[]
  dunningNotices       DunningNotice[]
  chargeWaivers        InvoiceChargeWaiver[]
  bankTransactions     BankTransaction[]
  bankBalances         BankBalance[]
  unitSettings         UnitSetting[]
  expenseCategories    ExpenseCategory[]
  categoryRules        CategoryRule[]
  recurringPayments    RecurringPayment[]
  incomingInvoices     IncomingInvoice[]
  sitePlans            SitePlan[]
  planServiceMappings  PlanServiceMapping[]
  maintenanceContracts MaintenanceContract[]
  contractTasks        ContractTask[]
  importSessions       ImportSession[]
  aiProviders          AiProviderConfig[]
  projectMessages      ProjectMessage[]
  projectMessageReads  ProjectMessageRead[]
}

// ─────────────────────────────────────────────
// Benutzer / Rollen / Rechte
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  active       Boolean  @default(true)
  // Wird bei Passwortänderung und Deaktivierung erhöht – alle vorher
  // ausgestellten Tokens werden damit sofort ungültig.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  roles               UserRole[]
  appointments        Appointment[]
  employee            Employee?
  documents           Document[]
  contractTasks       ContractTask[]
  projectMessages     ProjectMessage[]
  projectMessageReads ProjectMessageRead[]

  @@index([companyId])
}

model Role {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String // frei definierbar, keine Hardcoded-Rollen
  isSystem  Boolean @default(false) // z.B. Startvorlagen

  permissions RolePermission[]
  users       UserRole[]

  @@unique([companyId, name])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// Feste, im Code bekannte Permission-Keys (siehe src/common/permissions.ts)
model Permission {
  id    String @id @default(uuid())
  key   String @unique // z.B. "price.purchase.read"
  label String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────
// Kunde → Objekt → Projekt
// ─────────────────────────────────────────────
model Customer {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  // Rechnungsanschrift; fehlt sie, wird die Anschrift des Objekts verwendet.
  street         String?
  postalCode     String?
  city           String?
  // Käuferreferenz der E-Rechnung, bei öffentlichen Auftraggebern die Leitweg-ID
  buyerReference String?
  // USt-IdNr. des Kunden – nötig für E-Rechnungen nach § 13b UStG
  vatId          String?
  // Unternehmer statt Verbraucher: höherer Verzugszins, Verzugspauschale
  isBusiness     Boolean  @default(false)
  // Debitorenkonto in der Buchhaltung (DATEV: 10000–69999), fortlaufend
  debtorNumber   Int?
  createdAt      DateTime @default(now())

  properties Property[]

  @@unique([companyId, debtorNumber])
  @@index([companyId])
}

model Property {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String // z.B. "Hauptwohnsitz", "Ferienhaus Garten"
  street     String?
  postalCode String?
  city       String?

  projects Project[]

  @@index([customerId])
  @@index([companyId])
}

model Project {
  id         String        @id @default(uuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id])
  propertyId String
  property   Property      @relation(fields: [propertyId], references: [id])
  title      String
  status     ProjectStatus @default(open)
  createdAt  DateTime      @default(now())

  quotes               Quote[]
  orders               Order[]
  appointments         Appointment[]
  timeEntries          TimeEntry[]
  documents            Document[]
  sitePlans            SitePlan[]
  materialUsages       ProjectMaterialUsage[]
  invoices             Invoice[]
  maintenanceContracts MaintenanceContract[]
  messages             ProjectMessage[]
  messageReads         ProjectMessageRead[]

  @@index([companyId])
  @@index([propertyId])
}

// ─────────────────────────────────────────────
// Angebote (Punkt 21): Preise werden als SNAPSHOT gespeichert.
// Eine spätere Änderung von Article.salePrice darf ein bestehendes
// Angebot NICHT verändern – deshalb liegen unitPrice/costPerUnit/margin
// direkt auf QuoteLineItem und werden nie live nachberechnet.
// ─────────────────────────────────────────────
model Quote {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id])
  status       QuoteStatus  @default(draft)
  // Fortlaufende Nummer je Firma und Jahr, z.B. A-2026-0001
  number       String?
  totalNet     Decimal      @db.Decimal(12, 2)
  vatRate      Decimal      @default(19.00) @db.Decimal(5, 2)
  vatTreatment VatTreatment @default(standard)
  totalVat     Decimal      @default(0) @db.Decimal(12, 2)
  totalGross   Decimal      @default(0) @db.Decimal(12, 2)
  validUntil   DateTime?
  createdAt    DateTime     @default(now())

  lineItems QuoteLineItem[]
  order     Order?

  @@unique([companyId, number])
  @@index([projectId])
  @@index([companyId])
}

model QuoteLineItem {
  id               String            @id @default(uuid())
  quoteId          String
  quote            Quote             @relation(fields: [quoteId], references: [id])
  // Reihenfolge im Angebot (1, 2, 3 …) – ohne sie liefert die Datenbank die
  // Positionen in beliebiger Reihenfolge
  position         Int               @default(0)
  serviceId        String? // nur Referenz/Nachvollziehbarkeit, keine Live-Daten; null = freie Position
  description      String // Snapshot des Leistungsnamens zum Zeitpunkt der Erstellung
  unit             String
  // gerundete Menge (Angebot, PDF, Summe); die genaue Menge bleibt für die
  // Nachkalkulation erhalten
  quantity         Decimal           @db.Decimal(12, 3)
  quantityExact    Decimal?          @db.Decimal(14, 4)
  // Rundung nur für diese Position (sonst Leistung → Einheit → Firma)
  roundingDecimals Int?
  roundingMode     QuantityRounding?
  roundingStep     Decimal?          @db.Decimal(10, 3)
  // woher die angewandte Rundung kam: position, master, unit, company
  roundingSource   String?

  // Preis-Snapshot – ab hier ändert sich nichts mehr rückwirkend:
  costPerUnit   Decimal @db.Decimal(10, 2)
  unitPrice     Decimal @db.Decimal(10, 2) // = salePricePerUnit zum Zeitpunkt X
  marginPerUnit Decimal @db.Decimal(10, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  // Soll-Werte für die Nachkalkulation, eingefroren wie der Preis. Ohne sie
  // würde eine spätere Rezepturänderung den Soll-Ist-Vergleich verfälschen.
  // null bei Positionen, die vor Einführung dieser Felder entstanden sind.
  plannedLaborMinutesPerUnit Int?
  plannedMaterialCostPerUnit Decimal? @db.Decimal(14, 6)

  @@index([quoteId])
  @@index([serviceId])
}

// ─────────────────────────────────────────────
// Auftrag (Punkt 22): entsteht aus einem angenommenen Angebot.
// Ein Angebot kann höchstens einen Auftrag erzeugen (quoteId @unique) –
// verhindert doppelte Auftragserzeugung aus demselben Angebot.
// ─────────────────────────────────────────────
model Order {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  projectId String
  project   Project     @relation(fields: [projectId], references: [id])
  quoteId   String      @unique
  quote     Quote       @relation(fields: [quoteId], references: [id])
  status    OrderStatus @default(open)
  totalNet  Decimal     @db.Decimal(12, 2) // vom Angebot übernommener Snapshot
  invoices  Invoice[]
  createdAt DateTime    @default(now())

  @@index([projectId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// Stammdaten: Artikel & Dienstleistungen (Rezepturen)
// ─────────────────────────────────────────────
model Article {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  articleNumber    String
  name             String
  unit             String // z.B. "m²", "Stk", "kg"
  purchasePrice    Decimal           @db.Decimal(10, 2)
  // Rundung der Mengen für diesen Artikel (leer = aus Einheit bzw. Firma)
  quantityDecimals Int?
  quantityRounding QuantityRounding?
  quantityStep     Decimal?          @db.Decimal(10, 3)
  salePrice        Decimal           @db.Decimal(10, 2)
  active           Boolean           @default(true)

  usages            ProjectMaterialUsage[]
  serviceComponents ServiceComponent[]

  @@unique([companyId, articleNumber])
}

model Service {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String // z.B. "1 m² Terrasse verlegen"
  unit             String
  // Rundung der Mengen für diese Leistung (leer = aus Einheit bzw. Firma)
  quantityDecimals Int?
  quantityRounding QuantityRounding?
  quantityStep     Decimal?          @db.Decimal(10, 3)

  components   ServiceComponent[]
  planMappings PlanServiceMapping[]

  @@index([companyId])
}

model ServiceComponent {
  id             String   @id @default(uuid())
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id])
  articleId      String?
  quantityPer    Decimal  @db.Decimal(10, 4) // Menge pro Einheit der Leistung
  laborMinutes   Int? // alternative: Arbeitszeit-Anteil
  article        Article? @relation(fields: [articleId], references: [id])
  // Maschineneinsatz je Einheit (z.B. 6 Min. Rüttelplatte je m²)
  machineId      String?
  machine        Machine? @relation(fields: [machineId], references: [id])
  machineMinutes Int?

  @@index([serviceId])
  @@index([articleId])
  @@index([machineId])
}

// ─────────────────────────────────────────────
// Weitere Stammdaten: Lieferanten & Maschinen (Punkt 18)
// ─────────────────────────────────────────────
model Supplier {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  active    Boolean @default(true)

  @@index([companyId])
}

model Machine {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  name       String
  hourlyRate Decimal @db.Decimal(10, 2) // Maschinenkosten pro Stunde
  active     Boolean @default(true)

  serviceComponents ServiceComponent[]

  @@index([companyId])
}

// ─────────────────────────────────────────────
// Termine / "Mein Tag" (Punkt 23 & 24 im Ursprungsdokument)
// ─────────────────────────────────────────────
model Appointment {
  id             String            @id @default(uuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id])
  title          String
  startTime      DateTime
  endTime        DateTime?
  assignedUserId String?
  assignedUser   User?             @relation(fields: [assignedUserId], references: [id])
  notes          String?
  status         AppointmentStatus @default(planned)
  // aus einem Pflegevertrag geplant
  contractTaskId String?
  contractTask   ContractTask?     @relation(fields: [contractTaskId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([projectId])
  @@index([companyId])
  @@index([assignedUserId])
  @@index([contractTaskId])
}

// ─────────────────────────────────────────────
// Pflege- und Wartungsverträge: wiederkehrende Leistungen an einem Projekt
// (Objekt des Kunden). Die Einsätze werden als Termine geplant, die feste
// Vergütung wird je Abrechnungszeitraum als Rechnung (kind = periodic)
// erstellt. Der nächste Zeitraum ergibt sich aus den bisherigen Rechnungen.
// ─────────────────────────────────────────────
enum ContractStatus {
  active
  paused // keine neuen Einsätze und Rechnungen
  ended
}

model MaintenanceContract {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id])
  title           String
  status          ContractStatus    @default(active)
  startDate       DateTime          @db.Date
  endDate         DateTime?         @db.Date
  billingInterval RecurringInterval @default(monthly)
  // true: zu Beginn des Zeitraums abrechnen, false: nach dessen Ende
  billInAdvance   Boolean           @default(true)
  vatRate         Decimal           @db.Decimal(5, 2)
  vatTreatment    VatTreatment      @default(standard)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lines    ContractLine[]
  tasks    ContractTask[]
  invoices Invoice[]

  @@index([companyId])
  @@index([projectId])
}

// Vergütung je Abrechnungszeitraum (Positionen der Rechnung)
model ContractLine {
  id          String              @id @default(uuid())
  contractId  String
  contract    MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  position    Int
  description String
  unit        String
  quantity    Decimal             @db.Decimal(12, 3)
  unitPrice   Decimal             @db.Decimal(12, 2)

  @@index([contractId])
}

// Wiederkehrender Einsatz, z.B. "Rasen mähen" alle 2 Wochen von April bis Oktober
model ContractTask {
  id              String              @id @default(uuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id])
  contractId      String
  contract        MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title           String
  everyWeeks      Int
  // Saison als Monate 1–12; seasonFrom > seasonTo läuft über den Jahreswechsel
  seasonFrom      Int                 @default(1)
  seasonTo        Int                 @default(12)
  // Uhrzeit (Minuten nach Mitternacht, Ortszeit) und Dauer der Termine
  startMinutes    Int                 @default(480)
  durationMinutes Int                 @default(120)
  assignedUserId  String?
  assignedUser    User?               @relation(fields: [assignedUserId], references: [id])
  // nächster noch nicht geplanter Termin
  nextDue         DateTime            @db.Date

  appointments Appointment[]

  @@index([companyId])
  @@index([contractId])
  @@index([assignedUserId])
}

// ─────────────────────────────────────────────
// Mitarbeiter & Zeiterfassung (Punkt 12 & 29 im Ursprungsdokument)
// Mitarbeiter ist bewusst von User getrennt: nicht jeder Mitarbeiter
// braucht einen Login-Account (z.B. Saisonkräfte ohne App-Zugang).
// ─────────────────────────────────────────────
model Employee {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String? @unique // optionale Verknüpfung zu einem Login-Account
  user      User?   @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  active    Boolean @default(true)

  timeEntries TimeEntry[]

  @@index([companyId])
}

model TimeEntry {
  id               String          @id @default(uuid())
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  startTime        DateTime
  endTime          DateTime?
  breakMinutes     Int             @default(0)
  activity         String?
  status           TimeEntryStatus @default(open) // open = läuft noch
  // Wer hat wann freigegeben (freigegebene Einträge sind gesperrt)
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())

  @@index([projectId])
  @@index([employeeId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// Dokumente (Punkt 6 & 15): NUR Metadaten. Der eigentliche Dateiinhalt
// (Foto, PDF, Plan, ...) liegt bewusst NICHT in der Datenbank, sondern in
// einem Objektspeicher (S3-kompatibel/MinIO o.ä.) – storagePath verweist
// nur dorthin. Die tatsächliche OCR-/Texterkennungs-Pipeline aus Punkt 15
// ist noch nicht implementiert (siehe STATUS.md); dieses Modell legt die
// Grundlage (Dokumenttyp, Zuordnung zu Projekt, Hochlade-Protokoll).
// ─────────────────────────────────────────────
model Document {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  projectId        String?
  project          Project?         @relation(fields: [projectId], references: [id])
  fileName         String
  documentType     String           @default("other") // invoice, quote, delivery_note, price_list, floor_plan, other, ...
  storagePath      String // Verweis auf den Objektspeicher, KEIN Dateiinhalt
  uploadedByUserId String?
  uploadedByUser   User?            @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime         @default(now())
  // Texterkennung beim Hochladen (optional): Stand und erkannter Text,
  // durchsuchbar über GET /documents/by-project/:id?q=
  ocrStatus        OcrJobStatus?
  ocrText          String?
  ocrJobs          OcrJob[]
  payable          IncomingInvoice?
  sitePlans        SitePlan[]
  message          ProjectMessage?

  @@index([companyId])
  @@index([projectId])
}

// ─────────────────────────────────────────────
// Materialverbrauch (Punkt 27: Baustellendokumentation; Punkt 28:
// Nachkalkulation braucht Ist-Material neben Ist-Arbeitszeit).
// ─────────────────────────────────────────────
model ProjectMaterialUsage {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  articleId        String
  article          Article  @relation(fields: [articleId], references: [id])
  quantity         Decimal  @db.Decimal(12, 3)
  recordedByUserId String?
  createdAt        DateTime @default(now())

  @@index([projectId])
  @@index([articleId])
  @@index([companyId])
}

// ─────────────────────────────────────────────
// Audit-Log (Punkt 36 im Ursprungsdokument)
// ─────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  source    String   @default("manual") // manual | import | ai | system
  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, entityId])
}

// ─────────────────────────────────────────────
// Status-Werte (dieselben Werte wie bisher als Text – die API bleibt
// unverändert, ungültige Werte lehnt jetzt aber schon die Datenbank ab)
// ─────────────────────────────────────────────

enum ProjectStatus {
  open
  in_progress
  done
  cancelled
}

enum QuoteStatus {
  draft
  approved
  sent
  accepted
  rejected
  expired
}

enum OrderStatus {
  open
  in_progress
  done
  cancelled
}

enum AppointmentStatus {
  planned
  done
  cancelled
}

// open = Zeiterfassung läuft noch
enum TimeEntryStatus {
  open
  completed
  approved
}

// Zähler für fortlaufende Belegnummern (Angebote, später Rechnungen) je
// Firma, Belegart und Jahr. Wird per INSERT ... ON CONFLICT atomar erhöht.
model NumberSequence {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  kind      String // "quote", später "invoice"
  year      Int
  lastValue Int     @default(0)

  @@id([companyId, kind, year])
}

// ─────────────────────────────────────────────
// Rechnungen (Abschlag, Schluss, Storno)
// Entwürfe sind änderbar; ab "issued" ist eine Rechnung unveränderlich
// (GoBD). Korrigiert wird nur über eine Stornorechnung. Die Nummer wird
// erst beim Ausstellen vergeben – so bleibt der Nummernkreis lückenlos.
// ─────────────────────────────────────────────

// Kontenrahmen für den DATEV-Export
enum DatevChart {
  SKR03
  SKR04
}

// Umsatzsteuerliche Behandlung eines Angebots bzw. einer Rechnung
// Texterkennung im Hintergrund (siehe ocr/ocr-queue.ts)
enum OcrJobStatus {
  queued
  running
  done
  failed
}

// Plätze für gleichzeitige Texterkennungen über alle Server-Instanzen
// (OCR_CONCURRENCY). Ein Platz ist belegt, solange sein Halter ihn verlängert.
// Verlauf der Betriebswerte: ein Messpunkt je Minute und Server, als
// Grundlage für die Alarmschwellen (metrics/history). Nur Summen über alle
// Firmen, keine Mandantendaten; wird nach METRICS_HISTORY_DAYS gelöscht.
model MetricSample {
  id                  String   @id @default(uuid())
  at                  DateTime @default(now())
  instance            String
  requests            Int
  serverErrors        Int
  // Anfragen je Dauer-Bucket (nicht kumuliert), Grenzen wie LATENCY_BUCKETS, zuletzt +Inf
  latencyBuckets      Int[]
  eventLoopP99Seconds Float
  rssBytes            Float
  ocrWaiting          Int
  mailFailures        Int

  @@index([at])
}

// Eingelesene Quelle des Stammdaten-Imports bis zur Übernahme (höchstens
// einen Tag): Vorschau und Übernahme arbeiten mit derselben Tabelle, ohne
// dass der Browser die Daten erneut schickt
model ImportSession {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  userId    String
  source    String
  headers   Json
  rows      Json
  createdAt DateTime @default(now())

  @@index([companyId])
}

// ─────────────────────────────────────────────
// KI-Anbieter je Firma – bewusst offen: OpenAI-kompatible APIs (auch selbst
// gehostet: Ollama, LM Studio, vLLM, LocalAI), Anthropic oder ein eigener
// Agent über einen festen HTTP-Vertrag (siehe KI-ANBINDUNG.md). Der Schlüssel
// liegt verschlüsselt (AES-256-GCM, common/secret-box.ts) und verlässt den
// Server nie wieder.
// ─────────────────────────────────────────────
model AiProviderConfig {
  id              String         @id @default(uuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  name            String
  kind            AiProviderKind
  baseUrl         String
  model           String?
  apiKeyEncrypted String?
  enabled         Boolean        @default(true)
  isDefault       Boolean        @default(false)
  timeoutSeconds  Int            @default(60)
  maxTokens       Int            @default(1024)
  // Hinweis an das Modell, z.B. Sprache und Tonfall
  systemPrompt    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([companyId])
}

enum AiProviderKind {
  openai_compatible
  anthropic
  agent
}

// ─────────────────────────────────────────────
// Baustelle: Nachrichten zwischen Büro und Baustelle je Projekt, optional
// mit Foto (Document, documentType "photo")
// ─────────────────────────────────────────────
model ProjectMessage {
  id           String    @id @default(uuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  authorUserId String
  author       User      @relation(fields: [authorUserId], references: [id])
  text         String?
  documentId   String?   @unique
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  // vom Gerät vergeben: aus der Offline-Warteschlange nur einmal angelegt
  clientId     String?
  createdAt    DateTime  @default(now())

  @@unique([companyId, clientId])
  @@index([companyId])
  @@index([projectId, createdAt])
}

// bis wann ein Nutzer die Nachrichten eines Projekts gelesen hat
model ProjectMessageRead {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lastReadAt DateTime

  @@unique([projectId, userId])
  @@index([companyId])
}

model OcrSlot {
  id          Int       @id
  holder      String?
  leasedUntil DateTime?
}

model OcrJob {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  userId      String?
  fileName    String
  // Auftrag zu einem hochgeladenen Dokument: das Ergebnis landet dort
  documentId  String?
  document    Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  status      OcrJobStatus @default(queued)
  // Server, der den Auftrag bearbeitet, und dessen letztes Lebenszeichen –
  // Aufträge ohne Lebenszeichen gelten nach 2 Minuten als abgebrochen
  worker      String?
  heartbeatAt DateTime?
  result      Json?
  error       String?
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  @@index([companyId, createdAt])
  @@index([documentId])
}

enum VatTreatment {
  standard // mit Umsatzsteuer
  small_business // Kleinunternehmer, § 19 UStG: keine Umsatzsteuer
  reverse_charge // § 13b UStG: der Leistungsempfänger schuldet die Steuer
}

enum InvoiceKind {
  partial // Abschlagsrechnung
  final // Schlussrechnung (zieht ausgestellte Abschläge ab)
  cancellation // Stornorechnung
  periodic // Rechnung aus einem Pflegevertrag für einen Abrechnungszeitraum
}

enum InvoiceStatus {
  draft
  issued
  cancelled // durch eine Stornorechnung aufgehoben
}

model Invoice {
  id         String               @id @default(uuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id])
  projectId  String
  project    Project              @relation(fields: [projectId], references: [id])
  // Grundlage: ein Auftrag oder ein Pflegevertrag (genau eins von beiden)
  orderId    String?
  order      Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  contractId String?
  contract   MaintenanceContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  kind       InvoiceKind
  status     InvoiceStatus        @default(draft)
  number     String? // R-2026-0001, erst beim Ausstellen
  issueDate  DateTime?

  // Leistungszeitraum (§ 14 UStG); ohne Angabe gilt das Rechnungsdatum
  servicePeriodStart DateTime?
  servicePeriodEnd   DateTime?

  vatRate      Decimal      @db.Decimal(5, 2)
  vatTreatment VatTreatment @default(standard)
  totalNet     Decimal      @db.Decimal(12, 2)
  totalVat     Decimal      @db.Decimal(12, 2)
  totalGross   Decimal      @db.Decimal(12, 2)

  // Rechnungssteller und -empfänger zum Zeitpunkt der Ausstellung, damit
  // eine spätere Adressänderung die Rechnung nicht verändert.
  sellerSnapshot Json?
  buyerSnapshot  Json?

  // Stornorechnung -> die aufgehobene Rechnung
  cancelsInvoiceId String?  @unique
  cancelsInvoice   Invoice? @relation("Cancellation", fields: [cancelsInvoiceId], references: [id])
  cancelledBy      Invoice? @relation("Cancellation")

  createdAt DateTime @default(now())

  lineItems      InvoiceLineItem[]
  payments       InvoicePayment[]
  dunningNotices DunningNotice[]
  chargeWaivers  InvoiceChargeWaiver[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([projectId])
  @@index([orderId])
  @@index([contractId])
}

model InvoiceLineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  unit        String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

// Zahlungseingang zu einer ausgestellten Rechnung. Die Rechnung selbst bleibt
// unverändert (GoBD); offen ist Bruttobetrag minus Summe der Zahlungen.
// Korrekturen durch Löschen der Zahlung (im Audit-Log festgehalten).
model InvoicePayment {
  id                String           @id @default(uuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  invoiceId         String
  invoice           Invoice          @relation(fields: [invoiceId], references: [id])
  amount            Decimal          @db.Decimal(12, 2)
  // davon auf Mahnkosten (Gebühren, Pauschale) und Verzugszinsen verrechnet
  // (§ 367 BGB: erst Kosten, dann Zinsen, dann Rechnungsbetrag)
  costsAmount       Decimal          @default(0) @db.Decimal(12, 2)
  interestAmount    Decimal          @default(0) @db.Decimal(12, 2)
  paidOn            DateTime         @db.Date
  method            PaymentMethod    @default(bank)
  note              String?
  // gebucht aus dem Bankabgleich
  bankTransactionId String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  createdByUserId   String?
  createdAt         DateTime         @default(now())

  @@index([companyId])
  @@index([invoiceId])
  @@index([bankTransactionId])
}

// Mahnung zu einer überfälligen Rechnung: Stufe 1 = Zahlungserinnerung,
// 2 = 1. Mahnung, 3 = 2. Mahnung. Offener Betrag und Frist werden beim
// Erstellen festgehalten (das PDF zeigt immer den Stand von damals).
model DunningNotice {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  level           Int
  issuedOn        DateTime  @db.Date
  deadline        DateTime  @db.Date
  openAmount      Decimal   @db.Decimal(12, 2)
  // Forderungen neben der Rechnung (siehe invoices/dunning-charges.ts)
  fee             Decimal   @default(0) @db.Decimal(10, 2)
  interest        Decimal   @default(0) @db.Decimal(10, 2)
  interestRate    Decimal?  @db.Decimal(5, 2)
  interestFrom    DateTime? @db.Date
  lumpSum         Decimal   @default(0) @db.Decimal(10, 2)
  createdByUserId String?
  sentAt          DateTime?
  sentTo          String?
  createdAt       DateTime  @default(now())

  @@unique([invoiceId, level])
  @@index([companyId])
}

// Erlassene Mahnkosten und Zinsen (die Rechnung selbst bleibt unverändert)
model InvoiceChargeWaiver {
  id              String   @id @default(uuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([invoiceId])
}

// Zahlungseingang vom Kontoauszug (CAMT.053). Erst nach Bestätigung wird
// daraus eine Zahlung zur Rechnung (paymentId). dedupeKey verhindert, dass
// ein erneut eingelesener Auszug Umsätze doppelt anlegt.
model BankTransaction {
  id               String                @id @default(uuid())
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id])
  dedupeKey        String
  accountIban      String?
  bookingDate      DateTime              @db.Date
  // immer positiv; Gutschrift (Zahlungseingang) oder Abbuchung
  amount           Decimal               @db.Decimal(12, 2)
  direction        BankDirection         @default(credit)
  // Rückbuchung: nicht im Bankabgleich, im Finanzbereich gekennzeichnet
  reversal         Boolean               @default(false)
  // Zahler bei Gutschriften, Empfänger bei Abbuchungen
  counterpartyName String?
  counterpartyIban String?
  remittance       String?
  // Bankabgleich (Zuordnung zu Rechnungen) nur für Gutschriften
  status           BankTransactionStatus @default(open)
  // Kategorie (Ausgaben): per Regel, gelernt oder von Hand zugeordnet
  categoryId       String?
  category         ExpenseCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categorySource   CategorySource?
  categorizedAt    DateTime?
  createdByUserId  String?
  createdAt        DateTime              @default(now())
  // Zahlungen aus diesem Umsatz (mehrere, wenn er mehrere Rechnungen begleicht);
  // "booked", sobald der ganze Betrag verteilt ist
  payments         InvoicePayment[]
  payable          IncomingInvoice?

  @@unique([companyId, dedupeKey])
  @@index([companyId, status])
  @@index([companyId, bookingDate])
}

// Rundungsart der Mengen
enum QuantityRounding {
  half_up // kaufmännisch
  up // immer aufrunden (Material, das man nur ganz kauft)
  down
}

// Einstellungen je Einheit: Rundung für Katalog-Einheiten anpassen oder
// eigene Einheiten anlegen (dann mit Bezeichnung)
model UnitSetting {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  code      String // Katalog-Code ("m²") oder eigene Einheit ("Rolle")
  label     String?
  decimals  Int?
  rounding  QuantityRounding?
  step      Decimal?          @db.Decimal(10, 3)
  createdAt DateTime          @default(now())

  @@unique([companyId, code])
}

// Kategorien für Ausgaben (Finanzbereich)
model ExpenseCategory {
  id           String             @id @default(uuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  name         String
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  transactions BankTransaction[]
  rules        CategoryRule[]
  recurring    RecurringPayment[]
  payables     IncomingInvoice[]

  @@unique([companyId, name])
}

// Stichwort-Regel: enthält Empfänger/Verwendungszweck das Muster (bzw. ist
// die IBAN gleich), wird die Kategorie vorgeschlagen
model CategoryRule {
  id         String            @id @default(uuid())
  companyId  String
  company    Company           @relation(fields: [companyId], references: [id])
  categoryId String
  category   ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pattern    String
  field      CategoryRuleField @default(any)
  createdAt  DateTime          @default(now())

  @@index([companyId])
}

enum CategoryRuleField {
  any // Empfänger oder Verwendungszweck
  counterparty
  remittance
  iban
}

enum CategorySource {
  rule
  learned
  manual
}

// Wiederkehrende Ausgabe (Fixkosten): Miete, Leasing, Versicherung …
model RecurringPayment {
  id               String            @id @default(uuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String
  counterpartyName String?
  counterpartyIban String?
  amount           Decimal           @db.Decimal(12, 2)
  interval         RecurringInterval
  // nächste Fälligkeit (Stichtag für den Rhythmus)
  nextDue          DateTime          @db.Date
  endDate          DateTime?         @db.Date
  categoryId       String?
  category         ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())

  @@index([companyId])
}

enum RecurringInterval {
  monthly
  quarterly
  halfyearly
  yearly
}

enum BankDirection {
  credit
  debit
}

// Gebuchter Kontostand (Schlusssaldo) je Konto und Tag, aus dem Kontoauszug
model BankBalance {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  accountIban String
  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2) // negativ bei Soll-Saldo
  createdAt   DateTime @default(now())

  @@unique([companyId, accountIban, date])
}

enum BankTransactionStatus {
  open
  booked
  ignored
}

enum PaymentMethod {
  bank
  cash
  other
}

// Eingangsrechnungen: was die Firma selbst bezahlen muss. Erfasst aus einer
// E-Rechnung (XRechnung/ZUGFeRD), aus dem Text einer PDF bzw. eines Fotos oder
// von Hand; bezahlt per Abbuchung aus dem Kontoauszug oder von Hand.
enum PayableStatus {
  open
  paid
  cancelled
}

enum PayableSource {
  manual
  text
  einvoice
}

model IncomingInvoice {
  id                     String           @id @default(uuid())
  companyId              String
  company                Company          @relation(fields: [companyId], references: [id])
  supplierName           String
  supplierIban           String?
  invoiceNumber          String?
  invoiceDate            DateTime?        @db.Date
  dueDate                DateTime?        @db.Date
  amount                 Decimal          @db.Decimal(12, 2) // brutto, zu zahlen
  netAmount              Decimal?         @db.Decimal(12, 2)
  vatAmount              Decimal?         @db.Decimal(12, 2)
  discountPercent        Decimal?         @db.Decimal(5, 2) // Skonto
  discountUntil          DateTime?        @db.Date
  categoryId             String?
  category               ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  documentId             String?          @unique
  document               Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  source                 PayableSource    @default(manual)
  status                 PayableStatus    @default(open)
  paidAt                 DateTime?        @db.Date
  paidAmount             Decimal?         @db.Decimal(12, 2)
  bankTransactionId      String?          @unique
  bankTransaction        BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  // beim "Wieder öffnen" verworfene Abbuchungen: nicht erneut zuordnen
  rejectedTransactionIds String[]         @default([])
  notes                  String?
  createdByUserId        String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([companyId, status])
}

// Lageplan am Projekt: Entwässerung, Leitungen, Flächen, Zäune/Tore/Türen,
// Symbole. Objekte als JSON in Planeinheiten (bei Hintergrundbild dessen
// Pixel), Maßstab unitsPerMeter. version schützt gegen gegenseitiges
// Überschreiben beim gleichzeitigen Bearbeiten.
model SitePlan {
  id                   String    @id @default(uuid())
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id])
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id])
  name                 String
  unitsPerMeter        Float     @default(50)
  backgroundDocumentId String?
  backgroundDocument   Document? @relation(fields: [backgroundDocumentId], references: [id], onDelete: SetNull)
  backgroundWidth      Int?
  backgroundHeight     Int?
  objects              Json      @default("[]")
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId])
  @@index([projectId])
}

// Welche Leistung zu einer Menge aus dem Lageplan gehört (z.B. "lawn" ->
// "Rasen anlegen", "lawn:mowingEdge" -> "Mähkante setzen"); je Firma,
// gemerkt beim Übernehmen ins Angebot
model PlanServiceMapping {
  id          String  @id @default(uuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  quantityKey String
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([companyId, quantityKey])
}

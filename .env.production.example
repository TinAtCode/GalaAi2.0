# Vorlage für docker-compose.prod.yml – kopieren nach .env.production und ausfüllen.
# Lange Zufallswerte erzeugen mit: openssl rand -hex 32
# (Hex, weil das Passwort auch in der Datenbank-URL steht – /, @ oder : würden sie zerbrechen)
POSTGRES_PASSWORD=
JWT_SECRET=
# Schlüssel für verschlüsselt gespeicherte Geheimnisse (API-Schlüssel der KI-Anbieter).
# Einmal setzen und nie wieder ändern (sonst müssen die Schlüssel neu eingegeben werden).
# Leer = abgeleitet aus JWT_SECRET. Erzeugen mit: openssl rand -hex 32
SECRET_KEY=
# 1 = KI-Anbieter nur im Internet, keine Adressen im eigenen Netz (z.B. bei mehreren Firmen
# auf einem Server). Leer = selbst gehostete Modelle im LAN erlaubt (Ollama, LM Studio …).
AI_BLOCK_PRIVATE_NETWORKS=
# Push-Nachrichten aufs Handy (Baustelle): Kontaktadresse für die Push-Dienste der Browser,
# z.B. mailto:it@firma.de. Die Schlüssel dafür erzeugt GartenAI selbst.
PUSH_CONTACT=
# Proxys vor dem Backend: 2 = HTTPS-Reverse-Proxy + nginx (Normalfall), 1 = ohne vorgeschalteten Proxy.
# Falsch gesetzt teilen sich alle Nutzer ein Login-Limit (zu niedrig) oder IPs lassen sich fälschen (zu hoch).
TRUST_PROXY=2
# Port des Frontends auf dem Server (dahinter HTTPS-Reverse-Proxy)
APP_PORT=8080
# Nur für einen Test ohne HTTPS auf 0 setzen – sonst schickt der Browser das
# Sitzungs-Cookie nicht. Im Betrieb leer lassen (Secure an).
COOKIE_SECURE=
# E-Mail-Versand, z.B. SMTP_URL=smtps://nutzer:passwort@mail.example.de:465
SMTP_URL=
MAIL_FROM=
# Token für Prometheus (GET /api/metrics); leer = abgeschaltet
METRICS_TOKEN=
# Verlauf für die Alarmschwellen: off = abgeschaltet; Aufbewahrung in Tagen (Standard 90)
METRICS_HISTORY=
METRICS_HISTORY_DAYS=
OCR_CONCURRENCY=2
# Dokumente im S3-kompatiblen Objektspeicher statt im Dateisystem: STORAGE=s3
# (AWS, Hetzner, IONOS, Wasabi, MinIO …). Bucket vorher anlegen. S3_ENDPOINT leer = AWS.
# S3_FORCE_PATH_STYLE: Standard an, sobald S3_ENDPOINT gesetzt ist. S3_SSE=AES256 für
# serverseitige Verschlüsselung. Umzug vorhandener Dateien: node dist/cli/migrate-storage.js
STORAGE=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_FORCE_PATH_STYLE=
S3_SSE=

# Anmelden mit Google (oder Microsoft, Nextcloud, Keycloak …) – nur für
# bestehende Konten, zugeordnet über die E-Mail-Adresse. Siehe BETRIEB.md.
# OIDC_ISSUER leer = Google
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# https://<Ihre Adresse>/api/auth/oidc/callback
OIDC_REDIRECT_URI=
# optional: nur diese Domains, z.B. musterbetrieb.de
OIDC_ALLOWED_DOMAINS=

# HTTPS für die Demo im LAN – Zertifikat der eigenen Demo-Zertifizierungsstelle
# (ops/demo/certs, erzeugt von ops/demo/make-certs.sh). Unter /demo-ca.crt
# liegt das Stammzertifikat zum Installieren auf dem Handy.
{
	admin off
	auto_https off
}

:8443 {
	tls /certs/server.crt /certs/server.key
	handle /demo-ca.crt {
		root * /certs
		rewrite * /ca.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		reverse_proxy frontend:8080 {
			header_up X-Forwarded-Proto https
		}
	}
}
